{
 "components": {
  "schemas": {
   "AlarmEvent": {
    "description": "One record per alarm episode, written by the R2 observer on\nalarm.py's on_transition hook. presence_during is the RAW radar verdict\nfor the episode (R2 rule), never PresenceState.mode.",
    "properties": {
     "ack_source": {
      "anyOf": [
       {
        "enum": [
         "device",
         "app"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Ack Source"
     },
     "acknowledged_at": {
      "anyOf": [
       {
        "format": "date-time",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Acknowledged At"
     },
     "crossed_actual": {
      "default": false,
      "title": "Crossed Actual",
      "type": "boolean"
     },
     "escalated": {
      "default": false,
      "title": "Escalated",
      "type": "boolean"
     },
     "event_id": {
      "title": "Event Id",
      "type": "string"
     },
     "is_demo": {
      "default": false,
      "title": "Is Demo",
      "type": "boolean"
     },
     "presence_during": {
      "default": "unknown",
      "enum": [
       "home",
       "away",
       "unknown"
      ],
      "title": "Presence During",
      "type": "string"
     },
     "rearm_count": {
      "default": 0,
      "title": "Rearm Count",
      "type": "integer"
     },
     "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
     },
     "tier": {
      "enum": [
       "predicted_low",
       "actual_low",
       "stale",
       "high"
      ],
      "title": "Tier",
      "type": "string"
     }
    },
    "required": [
     "event_id",
     "tier",
     "started_at"
    ],
    "title": "AlarmEvent",
    "type": "object"
   },
