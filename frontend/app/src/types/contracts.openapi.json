   "DevicePairing": {
    "description": "The OWNER pairing (R5+): phone app <-> Pi through the relay. Separate\nfrom Pairing, whose peer_kind stays doctor | buddy. The token travels only\nin the QR or the typed code, never in a URL query.",
    "properties": {
     "device_id": {
      "title": "Device Id",
      "type": "string"
     },
     "device_url": {
      "title": "Device Url",
      "type": "string"
     },
     "paired_at": {
