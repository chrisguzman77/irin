# Irin — environment template. Copy to .env (never committed). Placeholder values only.
# Every name here is spelled exactly as backend/app/config.py, relay/main.py and cloud/main.py read it.

# --- Pi backend (backend/) ---
IRIN_HW=mock                      # mock | real
DATASOURCE=replay                 # replay | nightscout
SCENARIO=demo/scenarios/the_save.csv
REPLAY_SPEED=60.0
PIN=1234
NIGHTSCOUT_URL=https://your-nightscout.example
NIGHTSCOUT_TOKEN=changeme
ANTHROPIC_API_KEY=sk-ant-placeholder      # the direct-Anthropic link of the narrative chain
SMTP_HOST=smtp.example.com
SMTP_USER=user@example.com
SMTP_PASS=changeme
REPORT_EMAIL=you@example.com              # the morning report email

# --- Sponsor tiers (Pi side) ---
RELAY_URL=http://localhost:8100
CLOUD_URL=http://localhost:8200
# The Pi sends RELAY_SOURCE_KEY as X-Source-Key; the relay accepts the comma-separated
# RELAY_SOURCE_KEYS; one value serves both.
RELAY_SOURCE_KEY=devkey-changeme
RELAY_SOURCE_KEYS=devkey-changeme
RELAY_ADMIN_KEY=adminkey-changeme         # relay: the demo-only Spark simulation
RELAY_KEY=relaykey-changeme               # relay: encrypts emergency numbers at rest
DEVICE_ID=irin-dev-0001
DEVICE_TOKEN=devicetoken-changeme         # cloud ingest checks DEVICE_ID + DEVICE_TOKEN
DEVICE_URL=http://localhost:8000          # https://device.<DOMAIN> on the Pi
APP_ORIGIN=https://irin-out-of-sleep-at-hackgt.tech
INBOX_URL=https://doctor.irin-out-of-sleep-at-hackgt.tech
WATCH_URL=https://watch.irin-out-of-sleep-at-hackgt.tech
IRIN_BRAIN_ONLY=false

# --- Narrative chain (Backboard -> Meta direct -> direct Anthropic -> template) ---
NARRATIVE_BACKEND=template                # template | anthropic | backboard (the FIRST link)
BACKBOARD_API_KEY=bb-placeholder
META_MODEL_API_KEY=meta-placeholder       # provider "meta" is selected per task by NARRATIVE_ROUTING
# task -> [provider, model]; the eight tasks from docs/plans/chris.md R13+
NARRATIVE_ROUTING={"clinician_card":["anthropic","claude-sonnet-5"],"morning_report":["anthropic","claude-sonnet-5"],"buddy_line":["meta","muse-spark-1.3"],"family_story":["meta","muse-spark-1.3"],"match_explanation":["meta","muse-spark-1.3"],"emergency_script":["meta","muse-spark-1.3"],"availability_parse":["meta","muse-spark-1.3"],"second_opinion":["openai","gpt-5-mini"]}

# --- WhatsApp Cloud API (server only, relay/notify.py) ---
WHATSAPP_TOKEN=wa-placeholder
WHATSAPP_PHONE_NUMBER_ID=000000000000000

# --- Voice ---
VOICE_BACKEND=none                        # none | elevenlabs
ELEVENLABS_API_KEY=el-placeholder
ELEVENLABS_VOICE_DEVICE=voice-id-device   # the bedside voice
ELEVENLABS_VOICE_ALERT=voice-id-alert     # the alert-loop voice

# --- Server storage (Vultr .env; the laptop compose defaults to its own containers) ---
ATLAS_URI=mongodb://localhost:27017
TIGER_URI=postgresql://postgres:postgres@localhost:5432/irin
DOMAIN=irin-out-of-sleep-at-hackgt.tech

# --- Twilio (full tier only; not used at the hackathon) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
